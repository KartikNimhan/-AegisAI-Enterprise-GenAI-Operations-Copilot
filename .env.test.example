# Test-only settings for the AegisAI test suite.
#
# Copy this file to `.env.test` in the repository root (Git ignores `.env.test`) and replace
# CHANGE_ME with the password of the database role. Never put production credentials here.
#
# The test suite (backend/tests/isolation.py) and scripts/test_db.py refuse any database URL that
#   - contains spaces, control characters or "#",
#   - does not use the postgresql+asyncpg driver,
#   - points anywhere but this machine (localhost, 127.0.0.1 or ::1),
#   - has query parameters,
#   - %-encodes the host or the database name (a password may be %-encoded),
#   - names a database that is not lowercase letters, digits and underscores, starting with a
#     letter, ending in "_test", at most 63 characters, or
#   - names the same database as DATABASE_URL in `.env`.
# So these values can never reach your development database.
#
# Create the database once before using it: see docs/development/setup.md, "Running tests safely".

TEST_DATABASE_URL=postgresql+asyncpg://aegis:CHANGE_ME@localhost:5432/aegis_test

# A Redis database number different from the one REDIS_URL uses in `.env` (normally 0; a
# `?db=` in REDIS_URL counts). Use the host and port your local Redis listens on.
TEST_REDIS_URL=redis://localhost:6380/15
