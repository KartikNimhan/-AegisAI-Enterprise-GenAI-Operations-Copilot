# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# uv
.uv/

# Environment variables
.env
.env.*
!.env.example
!.env.test.example

# Testing & tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
htmlcov/
.coverage
coverage.xml

# Alembic (keep versions, ignore local sqlite if ever used)
*.sqlite3

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker
*.pid

# Data (keep directory structure, ignore contents)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/evaluation/*
!data/evaluation/.gitkeep
# Runtime document uploads (DOCUMENT_STORAGE_DIR), user data, never source (AIGSEC-016).
# An ignore rule does not untrack a file Git already tracks: the committed sample PDF stays.
data/uploads/*

# Redis persistence snapshots a local Redis writes into its working directory (dump.rdb).
*.rdb

# Logs
*.log
