# Copy to .env and adjust for your environment.
# This milestone adds the Groq-backed LLM gateway; future milestones
# (RAG, agents, MCP, etc.) will extend this file further.
#
# Every variable below is read by app.config.Settings (backend only; this
# .env file is never read from inside a container — see
# docs/architecture/decisions/012-deployment-architecture.md,
# "Configuration, secrets, and the two different '.env' mechanisms"). All
# have working defaults except GROQ_API_KEY, which is optional: the app
# starts and the test suite passes without it; only chat/agent/research
# endpoints return a typed 503 until it's set. Deployment-level settings
# that are NOT app.config.Settings fields — the backend's HOST/PORT, and
# the frontend's AEGIS_BACKEND_URL/AEGIS_BACKEND_TIMEOUT_SECONDS — are
# documented in the root Dockerfile/frontend/streamlit/Dockerfile and
# infra/kubernetes/*-configmap.yaml instead, not here.

APP_NAME=AegisAI
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Postgres (matches docker-compose.yml's host-mapped port; the backend
# container itself talks to postgres:5432 over the internal Docker network)
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5433/aegis

# Redis (matches docker-compose.yml's host-mapped port; the backend
# container itself talks to redis:6379 over the internal Docker network)
REDIS_URL=redis://localhost:6380/0

# CORS (JSON array of allowed origins). :8501 is the legacy Streamlit UI;
# :3000 is the React app's Docker-published port; :5173 is Vite's dev server.
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000","http://localhost:5173"]

# LLM Gateway (Groq — https://console.groq.com/keys)
# Leave blank to run the app without real LLM calls: the app still starts
# and the test suite still passes, but POST /api/v1/chat/completions will
# return a 503 until a real key is set here.
GROQ_API_KEY=""
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
FAST_LLM_MODEL=openai/gpt-oss-20b
SAFETY_LLM_MODEL=openai/gpt-oss-safeguard-20b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Document ingestion (Milestone 3). DOCUMENT_STORAGE_DIR defaults to
# data/uploads at the repo root (outside backend/app) when left unset here
# (commented out, not blank — an empty value would override that default
# with an actual empty path). Uncomment to override, e.g. in production:
# DOCUMENT_STORAGE_DIR=/var/lib/aegisai/documents
DOCUMENT_MAX_UPLOAD_SIZE_BYTES=20971520
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_ALLOWED_TYPES=["pdf","docx","txt","markdown"]

# Embeddings (Milestone 4 — see docs/architecture/decisions/006-embedding-model.md).
# EMBEDDING_DIMENSION must match EMBEDDING_MODEL exactly — it's also baked
# into the database schema (the pgvector column's fixed width), so changing
# the model to one with a different dimension requires a new migration.
# The model downloads from Hugging Face on first use (~90MB) and is cached
# locally afterward; no API key is needed.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_RETRIES=2

# RAG (Milestone 5 — see docs/architecture/decisions/007-rag-pipeline.md).
# RAG_SIMILARITY_THRESHOLD is a cosine SIMILARITY (1 - cosine_distance),
# not a raw distance. The default below is a conservative starting point,
# NOT a scientifically validated universal value — the correct threshold
# depends on the embedding model, normalization, corpus, and query
# distribution; tune it against real usage. RAG_MAX_RESULTS is a hard
# ceiling a client's top_k override cannot exceed.
RAG_TOP_K=5
RAG_MAX_RESULTS=20
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_CONTEXT_CHARS=8000

# Agents (Milestone 6 — see docs/architecture/decisions/008-agent-architecture.md).
# Conservative development defaults, not production-tuned claims.
# AGENT_MAX_STEPS bounds the number of agent/LLM turns in one run;
# AGENT_MAX_TOOL_CALLS bounds total tool invocations across the whole run;
# AGENT_TIMEOUT_SECONDS is a wall-clock backstop for the entire run.
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=10
AGENT_TIMEOUT_SECONDS=60.0

# MCP (Milestone 7 — see docs/architecture/decisions/009-mcp-a2a-architecture.md).
# A discovered MCP tool is never trusted just because the server returned
# it — both the server identity and the tool name must be in these
# allowlists before a tool is ever registered with the agent.
MCP_CLIENT_TIMEOUT_SECONDS=10.0
TRUSTED_MCP_SERVERS=["aegisai-internal"]
TRUSTED_MCP_TOOLS=["search_knowledge_base","calculator","get_document_metadata"]

# A2A (Milestone 7). TRUSTED_A2A_AGENTS is a base-URL allowlist — the
# orchestrator may only talk to a configured agent, never a user-supplied
# or runtime-discovered endpoint. The default points at this same app,
# since the Research Agent is served by it in this milestone (see the ADR)
# — change this if the Research Agent is ever deployed separately.
A2A_CLIENT_TIMEOUT_SECONDS=15.0
TRUSTED_A2A_AGENTS=["http://localhost:8000"]
RESEARCH_AGENT_NAME=AegisAI Research Agent
DOCUMENT_AGENT_NAME=AegisAI Document Agent
ANALYST_AGENT_NAME=AegisAI Analyst Agent

# Multi-agent orchestration (Milestone 8 — see
# docs/architecture/decisions/010-multi-agent-architecture.md).
# multi_agent_agent_timeout_seconds bounds one specialist call (including
# its own retries); multi_agent_timeout_seconds is a coarser whole-
# workflow backstop. max_agent_depth/max_agent_delegations are defense-
# in-depth loop guards — unreachable by this milestone's own topology
# (at most 3 agents, depth 2), but enforced regardless.
MULTI_AGENT_TIMEOUT_SECONDS=45.0
MULTI_AGENT_AGENT_TIMEOUT_SECONDS=20.0
MULTI_AGENT_MAX_RETRIES=1
MAX_AGENT_DEPTH=2
MAX_AGENT_DELEGATIONS=5

# Authentication (Milestone 12). The API verifies OIDC bearer access tokens;
# it holds no passwords or signing secrets (only public keys, fetched from
# AUTH_JWKS_URL). These are PUBLIC identifiers, not secrets. Leave all three
# blank for local development: every protected route then fails closed with
# 503 until they are set. When ENVIRONMENT is anything other than "local" the
# API refuses to start without all three, and requires https (loopback hosts
# excepted).
#  - AUTH_ISSUER must equal the token's `iss` claim EXACTLY (with Keycloak this
#    is the URL the browser used, e.g. http://localhost:18081/realms/<realm>).
#  - AUTH_AUDIENCE is the API audience that must appear in the token's `aud`.
#  - AUTH_JWKS_URL is the key-set URL the BACKEND uses; it is separate because
#    it may legitimately differ from the issuer's hostname (for example a
#    container-internal address).
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Browser sign-in for the React app (public values, not secrets). Read by docker
# compose for the frontend container, and for `npm run dev` as VITE_OIDC_AUTHORITY /
# VITE_OIDC_CLIENT_ID. OIDC_AUTHORITY is the identity provider's issuer URL exactly
# as the BROWSER reaches it (normally the same value as AUTH_ISSUER). OIDC_CLIENT_ID
# is the id of the public client (authorization code + PKCE, no secret) registered
# for this app in the provider; its valid redirect URI is the app's origin, e.g.
# http://localhost:3000/. Leave OIDC_AUTHORITY blank and the UI says sign-in is not
# configured.
OIDC_AUTHORITY=
OIDC_CLIENT_ID=aegisai-web
# Asymmetric algorithms only (HMAC and "none" are rejected at startup).
AUTH_ALLOWED_ALGORITHMS=["RS256"]
AUTH_LEEWAY_SECONDS=30
AUTH_JWKS_CACHE_SECONDS=600
AUTH_JWKS_MIN_REFRESH_SECONDS=30
AUTH_JWKS_TIMEOUT_SECONDS=5
# After a failed or malformed key-set fetch, no further fetch is attempted for
# this long (0 disables), so an identity-provider outage cannot stall every request.
AUTH_JWKS_FAILURE_COOLDOWN_SECONDS=5

# Rate limits (non-secret). Per signed-in user, in a sliding window, for the expensive operations:
# language-model requests (chat, RAG, agents, multi-agent, the Research/Analyst agent tasks),
# document uploads, and embedding jobs. The numbers are starting points to review, not
# recommendations. 0 switches that one limit off; RATE_LIMIT_ENABLED=false switches all off.
# Counted in memory PER PROCESS: with several workers or replicas each keeps its own count, so the
# effective limit is (limit x processes). If the limiter cannot enforce (its table is full of live
# entries) the request is refused with 503 rather than let through. See
# docs/operations/production-readiness.md.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LLM_REQUESTS=30
RATE_LIMIT_DOCUMENT_UPLOADS=10
RATE_LIMIT_EMBEDDING_JOBS=5
RATE_LIMIT_MAX_TRACKED_KEYS=100000
