# Rendered at container start by the nginx image's template step
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/), which substitutes
# only ${BACKEND_UPSTREAM}; nginx's own $variables are left alone ($aegis_csp and $aegis_hsts
# are nginx variables defined in conf.d/aegis-security-headers.conf by docker-entrypoint.sh).
server {
    # 8080, not 80: the unprivileged nginx image runs as a non-root user.
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Do not advertise the nginx version.
    server_tokens off;

    # Browser hardening for every response (`always`: error pages too). The Content-Security-Policy
    # and HSTS values are written at container start by docker-entrypoint.sh (AIGSEC-011) into
    # conf.d/aegis-security-headers.conf, from the configured API and sign-in provider origins:
    # scripts, styles, images and fonts from this origin only, connections and frames only to
    # those origins. HSTS is sent only when HSTS_MAX_AGE is set (HTTPS deployments). SAMEORIGIN
    # keeps the OIDC silent-renew frame, which returns to this same origin, working. A location
    # with its own add_header does NOT inherit these, so /config.js below repeats them.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy $aegis_csp always;
    add_header Strict-Transport-Security $aegis_hsts always;

    # config.js is regenerated by docker-entrypoint.sh on every container
    # start — never let a browser/proxy cache a stale backend URL.
    location = /config.js {
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy $aegis_csp always;
        add_header Strict-Transport-Security $aegis_hsts always;
        try_files /config.js =404;
    }

    # Liveness check used by the top-bar "Backend connected" indicator. With a
    # same-origin deployment the browser asks THIS origin for /health; without
    # this exact-match rule it would fall through to the SPA fallback below and
    # get index.html (HTTP 200, not JSON), so the indicator could never show the
    # backend as up. Only /health is forwarded (not /health/ready, which reports
    # dependency state, and not the backend's docs).
    location = /health {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    # Same-origin API access: the browser calls /api/... on this host and
    # nginx forwards it to the backend, so no separate externally reachable
    # backend URL (or CORS) is needed. The Authorization header and the
    # request path pass through unchanged. Only /api/ and the exact path
    # /health are proxied — the backend's docs and /health/ready are not
    # exposed through the frontend.
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Matches the backend's default upload limit (20 MB) plus multipart overhead.
        client_max_body_size 21m;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Server-sent events (the streaming chat endpoints) must reach the browser as they are
        # produced; buffering would hold the whole answer until it is complete.
        proxy_buffering off;
    }

    # Client-side routing (react-router): any path that isn't a real
    # static file falls back to index.html, which then renders the
    # matching route in the browser.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
